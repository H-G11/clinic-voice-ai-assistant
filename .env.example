# Mock enabled until the actual API contract is provided
MIS_MODE=mock
# Optional overrides; UI selects cached small by default, base as fallback
ASR_DEVICE=cpu
# ASR_MODEL=data/asr_models/small
DISABLE_TTS=0
ASR_BEAM_SIZE=5
ASR_VAD=0
# Set 1 to prohibit ASR model downloads (requires model already cached)
ASR_LOCAL_ONLY=1
TTS_ENGINE=auto
# Optional local model path; no downloads during synthesis
# PIPER_MODEL=data/models/ru_RU-irina-medium.onnx
# NEVER COMMIT AUTH TOKENS
